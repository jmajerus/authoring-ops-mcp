# authoring-ops-mcp's settings. None is needed to run it from a checkout on the LAN.

# The suite to watch, and where the "since" times are kept.
# OPS_SUITE=suites/authoring.json
# OPS_STATE=data/state.json

# The service. It polls the suite every OPS_POLL_SECONDS (0: only on POST /api/poll).
# OPS_HOST=0.0.0.0
# OPS_PORT=8000
# OPS_POLL_SECONDS=60

# The Cloudflare Access team, for /mcp through the portal (also set in /etc/authoring-ops-mcp/env on the host).
# ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com

# For `npm run deploy`: the deploy account's SSH password.
# AUTHORING_DEPLOY_PASSWORD=
